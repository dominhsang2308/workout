# Application Settings
PROJECT_NAME="Fitness Workout Planner & Tracker API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security & Authentication
# Generate a strong key in production: openssl rand -hex 32
SECRET_KEY="temporary-workout-secret-key-change-in-production-super-safe"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback:
DATABASE_URL="sqlite:///./workout_tracker.db"
# PostgreSQL Docker/Production:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/workout_tracker"

# CORS Configuration (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80"
