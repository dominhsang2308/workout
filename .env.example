# Global Environment Variables for Docker Compose

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workout_tracker

# Security (Generate secure secret for production: openssl rand -hex 32)
SECRET_KEY=temporary-workout-secret-key-change-in-production-super-safe

# Backend Settings
PROJECT_NAME="Fitness Workout Planner & Tracker API"
DEBUG=False
